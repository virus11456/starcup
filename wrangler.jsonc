{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "star-grail-online",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "cloudflare/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [
    { "name": "GRAIL_ROOMS", "class_name": "GrailRoom" },
    { "name": "GRAIL_DIRECTORY", "class_name": "GrailDirectory" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GrailRoom", "GrailDirectory"] }],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
